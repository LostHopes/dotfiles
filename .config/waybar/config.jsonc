{
    "layer": "top",
    "position": "top",
    "modules-left": ["hyprland/workspaces", "custom/media"],
    "modules-center": ["clock", "tray"],
    "modules-right": ["hyprland/language", "disk", "cpu", "memory", "network", "custom/brightness", "pulseaudio", "custom/power"],
    "margin-left": 5,
    "margin-right": 5,
    "margin-bottom": 0,
    
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "●",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": [],
            "6": [],
        }
    },

    "hyprland/language": {
      "format": "{short}",
    },

    "disk": {
      "interval": 30,
      "spacing": 10,
      "format": "󰋊 {percentage_used}%",
      "format-alt": "󰋊 {used}/{total}",
      "tooltip-format": "Path: {path}\nUsed: {used} ({percentage_used}%)\nFree: {free} ({percentage_free}%)\nTotal: {total}",
      "path": "/"
    },

    "tray": {
      "spacing": 20,
      "icon-size": 15,
    },

    "clock": {
	    "format": " {:%H:%M - %b %d}",
	    "format-alt": "{:%A, %B %d, %Y (%R)} 󰃰 ",
	    "tooltip-format": "<span size='9pt' font='WenQuanYi Zen Hei Mono'>{calendar}</span>",
	    "calendar": {
	      "mode"          : "year",
		    "mode-mon-col"  : 3,
		    "weeks-pos"     : "right",
		    "on-scroll"     : 1,
		    "on-click-right": "mode",
		    "format": {
			    "months":     "<span color='#cc241d'><b>{}</b></span>",
		      "days":       "<span color='#d79921'><b>{}</b></span>",
			    "weeks":      "<span color='#458588'><b>W{}</b></span>",
			    "weekdays":   "<span color='#98971a'><b>{}</b></span>",
			    "today":      "<span color='#b16286'><b><u>{}</u></b></span>"
		    }
	    },
	    "actions": {
		    "on-click-right": "mode",
		    "on-click-forward": "tz_up",
		    "on-click-backward": "tz_down",
		    "on-scroll-up": "shift_up",
		    "on-scroll-down": "shift_down"
	    },
    },
    
    "cpu": {
        "format": "\uf2db {usage}%",
        // "on-click": "alacritty -e btop"
    },
    
    "memory": {
        "interval": 30,
        "format": "\uf1b2 {percentage}%"
    },
    
    "network": {
        "format-wifi": "\uf1eb",
        "format-ethernet": "\uf796",
        "format-disconnected": "\uf127 ⚠"
    },

    "custom/power": {
        "format": "\uf011",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/power-menu.sh"
    },

    "custom/brightness": {
        "format": "\uf108 {}%",
        "exec": "ddcutil getvcp 10 | grep -o 'current value =[ ]*[0-9]*' | grep -o '[0-9]*'",
        "signal": 10,
        "tooltip": false
    },

    "custom/media": {
        "format": "\uf001 {}",
        "max-length": 30,
        "exec": "~/.config/waybar/scripts/scroll-media.sh",
        "interval": 1,
        "on-click": "playerctl play-pause"
    },
    
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": "\uf026",
        "format-icons": {
            "muted": "\uf6a9",
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "on-click": "pavucontrol"
    },
}
